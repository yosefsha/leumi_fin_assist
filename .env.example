# Copy to .env and fill in the two API keys. Real environment variables take
# precedence over values in .env.

# Required: Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=
# Required: Tavily API key (https://tavily.com/).
TAVILY_API_KEY=

# Claude model used by the agent.
ANTHROPIC_MODEL=claude-sonnet-5-5
# The 10-K Filing to answer from; relative paths resolve against the repository root.
FILING_PATH=data/apple_10k_2025.htm
# The filer, as the prompts, the banner and --help name it.
FILING_COMPANY=Apple Inc.
# Fiscal year the Filing reports on, written into every Filing citation as
# "10-K FY<year>". With a FILING_PATH other than the shipped Filing, FILING_COMPANY
# and FILING_FISCAL_YEAR are required.
FILING_FISCAL_YEAR=2025
# Optional: the Filing's own suggested questions (format of prompts/suggested_questions.txt).
# Unset, another company gets prompts/generic_suggested_questions.txt written for it.
SUGGESTED_QUESTIONS_PATH=
# Directory for the local retrieval index; relative paths resolve against the repository root.
INDEX_DIR=.index
# Standard logging level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Run the live query tests (pytest -m live), which call Anthropic and Tavily and
# spend tokens and search quota. Anything but "true" skips them (ADR-0004).
RUN_LIVE_TESTS=false
