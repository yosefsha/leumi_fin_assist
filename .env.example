# Copy to .env and fill in the two API keys. Real environment variables take
# precedence over values in .env.

# Required: Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=
# Required: Tavily API key (https://tavily.com/).
TAVILY_API_KEY=

# Claude model used by the agent.
ANTHROPIC_MODEL=claude-sonnet-5-5
# The 10-K Filing to answer from; relative paths resolve against the repository root.
FILING_PATH=data/apple_10k_2025.htm
# Directory for the local retrieval index; relative paths resolve against the repository root.
INDEX_DIR=.index
# Standard logging level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
